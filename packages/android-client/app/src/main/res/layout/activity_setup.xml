<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:text="@string/setup_brand"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/setup_title"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/setup_description"
            android:textColor="@color/ink_dim"
            android:textSize="14sp" />

        <!-- join -->
        <TextView
            style="@style/SetupSection"
            android:text="@string/setup_join_title" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/SetupField"
            android:hint="@string/setup_code_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/codeInput"
                style="@style/SetupMultiline" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/setup_scan"
                android:textColor="@color/cyan"
                app:strokeColor="@color/cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/joinButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/cyan"
                android:text="@string/setup_join"
                android:textColor="@color/bg"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- create -->
        <TextView
            style="@style/SetupSection"
            android:layout_marginTop="32dp"
            android:text="@string/setup_create_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_create_description"
            android:textColor="@color/ink_dim"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/SetupField"
            android:hint="@string/setup_network_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLength="60"
                android:text="@string/setup_default_network_name"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/SetupField"
            android:hint="@string/setup_firebase_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/firebaseInput"
                style="@style/SetupMultiline"
                android:minLines="5" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/SetupField"
            android:hint="@string/setup_turn_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/turnInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/setup_create"
            android:textColor="@color/cyan"
            app:strokeColor="@color/cyan" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/red"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
